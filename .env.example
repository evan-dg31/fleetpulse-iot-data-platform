# Source: create a Geotab demo DB first
GEOTAB_USERNAME=your-email@example.com
GEOTAB_PASSWORD=your-demo-password
GEOTAB_DATABASE=your-demo-database
# Set only when Geotab tells you a specific API server
GEOTAB_SERVER=
GEOTAB_FIRST_VERSION=0
# Use a DIFFERENT cursor path when switching Kafka destinations
GEOTAB_CURSOR_PATH=state/geotab_logrecord_cursor.json
GEOTAB_POLL_SECONDS=15

# Local: localhost:9092. Cloud: bootstrap address from your Kafka provider.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=fleetpulse.gps.raw
# For hosted SASL_SSL Kafka, add cluster key and secret. Leave blank for local Kafka.
KAFKA_API_KEY=
KAFKA_API_SECRET=
